{
  "info": {
    "name": "HouseKeepTrack",
    "description": "Hotel Housekeeping Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "ROOM",
      "item": [
        {
          "name": "Get All Rooms",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"]
            }
          }
        },
        {
          "name": "Get Room By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "1"]
            }
          }
        },
        {
          "name": "Create Room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"101\",\n  \"roomType\": \"Deluxe\",\n  \"status\": \"READY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"]
            }
          }
        },
        {
          "name": "Update Room",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"101\",\n  \"roomType\": \"Suite\",\n  \"status\": \"READY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "1"]
            }
          }
        },
        {
          "name": "Delete Room",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/rooms/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "1"]
            }
          }
        }
      ]
    },
